   IF N THEN
      ^
m004_type_mismatches.pseudo:12:7: Semantic error M004: The WHILE condition must be TRUE or FALSE, but this is a STRING
   WHILE "yes"
         ^
m004_type_mismatches.pseudo:14:18: Semantic error M004: + adds numbers. To join text use &, and NUM_TO_STR to turn a number into text
   OUTPUT "Total: " + N
                    ^
m004_type_mismatches.pseudo:15:8: Semantic error M004: A whole array cannot be output. Output its elements one at a time
   OUTPUT A
          ^
