DECLARE S : STRING
DECLARE C : CHAR
DECLARE A : ARRAY[1:3] OF INTEGER
N ← 3.5
S ← N
C ← "x"
IF N THEN
ENDIF
WHILE "yes"
ENDWHILE
OUTPUT "Total: " + N
OUTPUT A
OUTPUT A[1, 2]
OUTPUT N[1]
OUTPUT LENGTH(N)
FOR I ← 1 TO 2.5
NEXT I
CASE OF 1.5
ENDCASE
CALL Take("x")
PROCEDURE Take(V : INTEGER)
ENDPROCEDURE
FUNCTION Half(X : INTEGER) RETURNS INTEGER
   RETURN X / 2
ENDFUNCTION
