// FOR loops (spec 7.5).
Total ← 0
FOR I ← 1 TO 10
   Total ← Total + I
NEXT I
OUTPUT "Sum 1 to 10 = ", Total, ", I afterwards = ", I
FOR J ← 10 TO 1 STEP -3
   OUTPUT "J = ", J
NEXT J
FOR K ← 5 TO 1
   OUTPUT "never"
NEXT
OUTPUT "K keeps its start value: ", K
FOR Row ← 1 TO 2
   FOR Col ← 1 TO 3
      OUTPUT Row, ",", Col
   NEXT Col
NEXT Row
Last ← 3
FOR N ← 1 TO Last
   Last ← 10
NEXT N
OUTPUT "Bounds are evaluated once: N = ", N
