// Arithmetic and REAL output (spec 4.1, 6.2).
OUTPUT 7 / 2, " ", 6 / 3, " ", 1 / 3
OUTPUT 7 DIV 2, " ", -7 DIV 2, " ", 7 MOD 3, " ", -7 MOD 2, " ", 7 MOD -2
OUTPUT 2 + 3 * 4, " ", (2 + 3) * 4, " ", -2 * 3, " ", 10 - 2 - 3
OUTPUT 2.5 * 2, " ", 0.1 + 0.2, " ", 1 + 0.5, " ", 3.0
OUTPUT 10000000000.0 * 10000000000.0, " ", 1.0 / 10000000.0
OUTPUT 9223372036854775807, " ", -9223372036854775807 - 1
