// BYVAL and BYREF (spec 8.3).
A ← 1
B ← 2
CALL Swap(A, B)
OUTPUT "Swap: A = ", A, ", B = ", B
DECLARE Names : ARRAY[1:3] OF STRING
Names[1] ← "Ann"
Names[2] ← "Bob"
Names[3] ← "Cy"
CALL ChangeCopy(Names)
OUTPUT "After BYVAL: ", Names[1]
CALL Blank(Names)
OUTPUT "After BYREF: [", Names[1], "]"
CALL Fill(Answer)
OUTPUT "Undeclared BYREF argument: ", Answer
OUTPUT "Half of 7: ", Half(7)
// A BYREF keyword carries on to the following parameters.
PROCEDURE Swap(BYREF X : INTEGER, Y : INTEGER)
   Temp ← X
   X ← Y
   Y ← Temp
ENDPROCEDURE
PROCEDURE ChangeCopy(BYVAL List : ARRAY OF STRING)
   List[1] ← "changed"
ENDPROCEDURE
PROCEDURE Blank(BYREF List : ARRAY[1:3] OF STRING)
   FOR I ← 1 TO 3
      List[I] ← ""
   NEXT I
ENDPROCEDURE
PROCEDURE Fill(BYREF Result : INTEGER)
   Result ← 42
ENDPROCEDURE
FUNCTION Half(N : REAL) RETURNS REAL
   RETURN N / 2
ENDFUNCTION
