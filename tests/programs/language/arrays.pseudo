// Arrays (spec 5.3): any lower bound, 2D, whole-array copies.
DECLARE Grid : ARRAY[1:3, 1:3] OF CHAR
FOR R ← 1 TO 3
   FOR C ← 1 TO 3
      Grid[R, C] ← '.'
   NEXT C
NEXT R
Grid[2, 3] ← 'X'
DECLARE Saved : ARRAY[0:2, 0:2] OF CHAR
Saved ← Grid
Grid[2, 3] ← 'O'
OUTPUT "Grid[2,3] = ", Grid[2, 3], ", Saved[1,2] = ", Saved[1, 2]
DECLARE Temps : ARRAY[-2:2] OF REAL
FOR I ← -2 TO 2
   Temps[I] ← I * 1.5
NEXT I
OUTPUT Temps[-2], " ", Temps[0], " ", Temps[2]
Size ← 4
DECLARE Squares : ARRAY[1:Size] OF INTEGER
FOR I ← 1 TO Size
   Squares[I] ← I * I
NEXT I
OUTPUT "Bounds from a variable: ", Squares[4]
