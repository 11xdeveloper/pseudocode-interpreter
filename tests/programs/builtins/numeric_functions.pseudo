// Numeric functions (spec 9.2), with the spec's examples.
OUTPUT INT(27.5415), " ", INT(-2.7), " ", INT(7)
OUTPUT ROUND(2.675, 2), " ", ROUND(1.005, 2), " ", ROUND(-2.5, 0), " ", ROUND(2.5, 0)
OUTPUT ROUND(9.96, 1), " ", ROUND(-0.004, 2), " ", ROUND(3.14159, 10), " ", ROUND(7, 1)
OUTPUT MOD(10, 3), " ", DIV(10, 3), " ", MOD(-7, 2), " ", DIV(-7, 2)
